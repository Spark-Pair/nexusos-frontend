EXPO_PUBLIC_API_URL=https://api-nexusos.sparkpair.dev/api
# Google OAuth IDs are public client identifiers, not secrets. Backend GOOGLE_CLIENT_ID
# must allow all three audiences (comma-separated). OAuth needs an EAS development build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=
