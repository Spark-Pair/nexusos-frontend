{
  "expo": {
    "name": "NexusOS",
    "slug": "nexusos-mobile",
    "version": "1.0.0",
    "scheme": "nexusos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sparkpair.nexusos",
      "associatedDomains": ["applinks:nexusos.sparkpair.dev"]
    },
    "android": {
      "package": "com.sparkpair.nexusos",
      "intentFilters": [
        { "action": "VIEW", "autoVerify": true, "data": [{ "scheme": "https", "host": "nexusos.sparkpair.dev", "pathPrefix": "/join/" }], "category": ["BROWSABLE", "DEFAULT"] },
        { "action": "VIEW", "data": [{ "scheme": "nexusos", "host": "join" }], "category": ["BROWSABLE", "DEFAULT"] }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      ["expo-image-picker", { "photosPermission": "NexusOS uses photo access when you choose an image to share in a conversation." }],
      ["expo-notifications", { "color": "#245BFF" }]
    ]
  }
}
